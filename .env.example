# Environment Configuration for Energy Intelligence & Weather Analytics Platform

# Application Configuration
APP_ENV=production
DEBUG=False
HOST=0.0.0.0
PORT=8000
STREAMLIT_PORT=8501
API_PREFIX=/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:8501,http://127.0.0.1:8501
LOG_LEVEL=INFO

# Frontend to Backend Connectivity
API_BASE_URL=http://localhost:8000

# Database Configuration (PostgreSQL Production / SQLite Local Fallback)
# Format: postgresql://username:password@localhost:5432/energy_intelligence_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/energy_intelligence_db

# External Weather API Configuration (Open-Meteo as default free tier)
WEATHER_API_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_API_KEY=your_weather_api_key_optional

# External Energy API Configuration (U.S. EIA / Grid API)
ENERGY_API_BASE_URL=https://api.eia.gov/v2/
ENERGY_API_KEY=your_eia_api_key_optional

# Default Regional Coordinates & Meterological Zones
DEFAULT_LOCATION=London
DEFAULT_LATITUDE=51.5074
DEFAULT_LONGITUDE=-0.1278
DEFAULT_REGION=Grid_Alpha

# AI Analyst Provider Configuration ('openai', 'mock', or 'fallback')
AI_PROVIDER=fallback
AI_API_KEY=your_openai_api_key_optional
AI_MODEL=gpt-4o-mini
AI_MAX_TOKENS=500
AI_TEMPERATURE=0.2

# Smart Alert Center Thresholds
ALERT_COOLDOWN_MINUTES=30
ALERT_PERSISTENCE_COUNT=2
ENERGY_SPIKE_THRESHOLD_MW=3500.0
ENERGY_DROP_THRESHOLD_MW=1500.0
FORECAST_DEVIATION_THRESHOLD_PCT=15.0
RAIN_ALERT_THRESHOLD_PCT=60.0
EXTREME_TEMP_HIGH_C=35.0
EXTREME_TEMP_LOW_C=0.0
